# Shared secret for bot inbound POSTs (required in production)
VEGA_CHAT_SECRET=change-me-to-a-long-random-string

# Optional: webhook called when the user sends a message
# POST JSON: { id, role, content, createdAt, source }
VEGA_OUTBOUND_WEBHOOK=

# Listen port (default 3847)
PORT=3847

# Bind host (default 127.0.0.1 — use 0.0.0.0 only if you know why)
HOST=127.0.0.1
